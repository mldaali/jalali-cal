{
  "manifest_version": 3,
  "name": "تقویم فارسی | Persian Jalali Calendar",
  "short_name": "تقویم فارسی",
  "version": "1.2.0",
  "description": "تقویم پیشرفته و دقیق هجری شمسی برای فایرفاکس همراه با مناسبت‌ها و تعطیلات رسمی چندساله، یادداشت‌های محلی، کلیدهای میانبر، محاسبه بی‌درنگ با Intl API، رابط کاربری مدرن تیره و ابزار تبدیل تاریخ.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "تقویم فارسی (Alt+Shift+C)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "باز کردن فوری تقویم فارسی"
    }
  },
  "background": {
    "scripts": [
      "events.js",
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "persian-calendar@mldaali",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
